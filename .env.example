# ─── QuackTrack V2 Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in the values for local development.
# On Render, set these via the Render Dashboard > Environment.

# ─── Database (Required) ──────────────────────────────────────────────────────
# PostgreSQL connection string (Render provides this automatically if linked)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ─── SMTP Email (Optional - for faculty welcome emails) ──────────────────────
# For Gmail, use an App Password (not your regular password):
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=QuackTrack <your-email@gmail.com>

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
